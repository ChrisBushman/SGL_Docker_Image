[snmake]

CC = gcc
CFLAGS = -g -m2 -O2 -fomit-frame-pointer

AS = snasmsh2
ASFLAGS = /l /sdb

LD = snasmsh2
LDFLAGS = /sdb


INCLUDES = -Iincludes
AINCLUDES = -j includes


OBJS =  master.cof \
        mirq.cof \
        vdp1.cof \
        pad.cof \
        globals.cof

.o,.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $+

.cof,.asm
	$(AS) $(ASFLAGS) $(AINCLUDES) $+,$-


main.cof;	$(OBJS)
	snasmsh2 /sdb main.lnk,main


master.cof;	master.asm includes\globals.h

vdp1.cof;	vdp1.asm includes\globals.h

mirq.cof;	mirq.asm includes\globals.h

globals.cof;	globals.asm

pad.cof;	pad.asm includes\globals.h

test.o;         test.c

[Debug]
	c:\bug_2.10b\snbugsat
