;			.equ		$04	;data load flag
MAP_LOAD_BITPOS	.equ	7		;data load flag
Mem_map_size		.equ		$05	;(3)size

Mem_map_end		.equ		$100	;(w)

BANK_ID			.equ		0	;tone bank data id
SEQ_ID			.equ		1	;sequence data id
DSP_PRG_ID		.equ		2	;dsp program id
DSP_RAM_ID		.equ		3	;dsp work ram id
user4x			.equ		4	;user block id
user5x			.equ		5	;user block id
user6x			.equ		6	;user block id
user7x			.equ		7	;user block id
DATA_ID			.equ		0	;
INDX_ID			.equ		0	;
