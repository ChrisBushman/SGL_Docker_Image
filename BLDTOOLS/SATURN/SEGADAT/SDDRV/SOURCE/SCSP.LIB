CB_PTR_ADRS		.equ		$38	;l sequence pointer
CB_STS_ADRS		.equ		$3C	;l status pointer
up_down_flag		.equ		$40	;w 1:fade in/ff:fade out
seq_volume_arrival	.equ		$42	;ÉVÅ[ÉPÉìÉXÉ{ÉäÉÖÅ[ÉÄÇ…ÇÊÇÈâπó êÑà⁄ÇÃìûíBñ⁄ïWâπó ÅB
appointed_fade_rate	.equ		$44	;w fade rate
fade_count_variable	.equ		$46	;w fade counter
sequence_volume		.equ		$48	;w sequence volume
performance_flag	.equ		$4A	;ÇOà»äOÇÃÇ∆Ç´ââëtíÜÇé¶Ç∑ÅB
pause_flag		.equ		$4C	;ÇOà»äOÇÃÇ∆Ç´É|Å[ÉYíÜÇé¶Ç∑ÅB
;			.equ		$4E	;

;-----------------------------------------------------------------------;
;	dip switch							;
;-----------------------------------------------------------------------;
DSW_SEQ		.equ	7			; bit7 H = Sequence data decode mode
DSW_PRG_sel	.equ	6			; bit6 H = D-RAM è„Ç≈ 68k prg Ç é¿çs
						;      L = S-RAM è„Ç≈ 68k prg Ç âºé¿çs
		; low 2bits = timer ê›íËíl 	; bit1 , bit0
DSW_2msec		.equ		0		;  L   ,  L
DSW_4msec		.equ		1		;  L   ,  H
DSW_8msec		.equ		2		;  H   ,  L
DSW_16msec		.equ		3		;  H   ,  H
	;-------------------------------------------------------;
	;	LED_on_off_speed				;
	;-------------------------------------------------------;
CPU_LED_speed		.equ		$F00		;$800	; 
SEQ_LED_speed		.equ		$c0		;$a0	; word size
MIDI_LED_speed		.equ		10		; byte size
CTO_LED_speed		.equ		$20		; byte size
SCSI_LED_speed		.equ		$80		; byte size
NKON_LED_speed		.equ		$40		; byte size
err_timer		.equ		$4000		; ÉGÉâÅ[(àŸèÌ)éû ì_ñ≈ä‘äuéûä‘
;=======================================================================;
;	scsp register							;
;=======================================================================;
	;-------------------------------------------------------;
	;	slot register					;
	;-------------------------------------------------------;
SCSP_KXKB		.equ		$00
			; D15Å`13     ------
			; D12	  WO  [KYONEX] key-on execution
			; D11	  R/W [KYONB]  key-on bit
			; D10,9   R/W [SBCTL]  source bit invert control
			; D8,7    R/W [SSCTL]  sound source select
			; D6,5    R/W [LPCTL]  loop form select
			; D4      R/W [PCM8B]  wave bit range 8/16 select
			; D3Å`D0  R/W [SA(H)]  wave start addr.
SCSP_PCM_SA		.equ		$02	;[SA]  PCM start address
SCSP_PCM_LSA		.equ		$04	;[LSA] PCM loop start address
SCSP_PCM_LEA		.equ		$06	;[LEA] PCM loop end address
SCSP_D2R1R		.equ		$08	;[D2R],[D1R],[EHLD],[AR]
SCSP_EDLSKRS		.equ		$0A	;[LSLK],[KRS],[DL],[RR]
SCSP_FH_RR		.equ		$0B	;[DL(low)],[RR]
SCSP_SISD		.equ		$0C	;[SI],[SD]
SCSP_TLVL		.equ		$0D	;[TL]
SCSP_MDLSL		.equ		$0E	;[MDLSL]
SCSP_OCTFNS		.equ		$10	;[OCTFNS] don't bit set on D15,D10
SCSP_RELFO		.equ		$12	;[RELFO]
SCSP_PLFOS		.equ		$13	;[PLFOS]
SCSP_ISEL		.equ		$14	;[ISEL]
SCSP_DISDLPN		.equ		$16	;[DISDLPN]
SCSP_EFSDLPN		.equ		$17	;[EFSDLPN]
	;-------------------------------------------------------;
	;	common register					;
	;-------------------------------------------------------;
RG_M4DB			.equ		$400	; [M4D8]
RG_MVOL			.equ		$401	; [VERMVOL]
RG_RBP			.equ		$402	; [RBL],[RBP]
RG_MSTS			.equ		$404	; [SMIDIST]
RG_MIBUF		.equ		$405	; [SMIDIRD]
RG_MOBUF		.equ     	$407	; [SMIDIWR]
RG_DEBUG		.equ     	$408	; [MSLC/CA/SGC/EG]
RG_TACTL		.equ     	$418	; [TACTL]
RG_TIMA			.equ		$419	; [TIMA]
RG_TBCTL		.equ		$41A	; [TBCTL]
RG_TIMB			.equ		$41B	; [TIMB]
RG_TCCTL		.equ		$41C	; [TCCTL]
RG_TIMC			.equ		$41D	; [TIMC]
RG_SCIEB		.equ		$41E	; [SCIEB]
RG_SCIPD		.equ		$420	; [SCIPD]
RG_SCIRE		.equ		$422	; [SCIRE]
RG_SCILV0		.equ		$425	; [SCILV0]
RG_SCILV1		.equ		$427	; [SCILV1]
RG_SCILV2		.equ		$429	; [SCILV2]
RG_MCIEB		.equ		$42A	; [MCIEB]
RG_MCIPD		.equ		$42c	; SH2 interrupt request
RG_MCIRE		.equ		$42e	; SH2 interrupt reset
	;-------------------------------------------------------;
	;	dsp register					;
	;-------------------------------------------------------;
DSP_COEF		.equ		$700
DSP_MADRS		.equ		$780
DSP_MPRO		.equ		$800
DSP_TEMP		.equ		$C00
DSP_EFREG		.equ		$EC0
	;-------------------------------------------------------;
	;	SCSP register direct address			;
	;-------------------------------------------------------;
SCSP_SLOT0		.equ	IO_SCSP			; slot register(0-31) top address
SCSP_DBG_REG		.equ	IO_SCSP+RG_DEBUG	; debug register address
scsp_release_flag	.equ	IO_SCSP+RG_DEBUG	;
SCSP_DSP_COEF   	.equ	IO_SCSP+DSP_COEF	; DSP coef register
SCSP_DSP_MADRS  	.equ	IO_SCSP+DSP_MADRS	; DSP memory address register
SCSP_DSP_MPRO   	.equ	IO_SCSP+DSP_MPRO	; DSP micro program
SCSP_EXTS_L		.equ	IO_SCSP+$ee0     ; external input data stack Lch
SCSP_EXTS_R		.equ	IO_SCSP+$ee2     ; external input data stack Rch
SCSP_EFREG0		.equ	IO_SCSP+$ec0     ; effect register #0  output data
SCSP_EFREG1		.equ	IO_SCSP+$ec2     ; effect register #1  output data
SCSP_EFREG2		.equ	IO_SCSP+$ec4     ; effect register #2  output data
SCSP_EFREG3		.equ	IO_SCSP+$ec6     ; effect register #3  output data
SCSP_EFREG4		.equ	IO_SCSP+$ec8     ; effect register #4  output data
SCSP_EFREG5		.equ	IO_SCSP+$eca     ; effect register #5  output data
SCSP_EFREG6		.equ	IO_SCSP+$ecc     ; effect register #6  output data
SCSP_EFREG7		.equ	IO_SCSP+$ece     ; effect register #7  output data
SCSP_EFREG8		.equ	IO_SCSP+$ed0     ; effect register #8  output data
SCSP_EFREG9		.equ	IO_SCSP+$ed2     ; effect register #9  output data
SCSP_EFREG10		.equ	IO_SCSP+$ed4     ; effect register #10 output data
SCSP_EFREG11		.equ	IO_SCSP+$ed6     ; effect register #11 output data
SCSP_EFREG12		.equ	IO_SCSP+$ed8     ; effect register #12 output data
SCSP_EFREG13		.equ	IO_SCSP+$eda     ; effect register #13 output data
SCSP_EFREG14		.equ	IO_SCSP+$edc     ; effect register #14 output data
SCSP_EFREG15		.equ	IO_SCSP+$ede     ; effect register #15 output data

;=======================================================================;
;	data assign for scsp register					;
;=======================================================================;
	;-------------------------------------------------------;
	;	for scsp timer	(1,2,4,8,16msec)		;
	;-------------------------------------------------------;
timerA1m		.equ		$ff-$44		;0.9977msec
timerA2m		.equ		$ff-$58		;1.9955msec
timerA4m		.equ		$ff-$b1		;4.0136msec
TIMA_base		.equ		timerA4m	;[TACTL]timer-A 1sample increment

_4msec			.equ	4
_8msec			.equ	8
;				:   1msec  2msec  4msec  8msec 16msec 
TM_DLY			.equ	4	;     2      3      4      5      6   
TM_FRQ			.equ	6	;     8      7      6      5      4   
TM_HT			.equ	6	;     4      5      6      7      8   
TM_FD			.equ	6	;     4      5      6      7      8   
TM_EGT			.equ	7	;     5      6      7      8      -   
TM_EGR			.equ	3	;     5      4      3      2      1   
TM_RATE			.equ	4	;     6	     5      4      3      2

	;------- [TBCTL] timer b increment ---------------------;
;TIMB_VL		.equ		2*100H+0E9H	;1.99msec(inc ctr 4/44100sec)
TIMB_VL			.equ		1*100H+0D4H	;1.95msec(inc ctr 2/44100sec)
;TIMB_VL		.equ		0*100H+0D3H	;0.98msec(inc ctr 1/44100sec)
	;-------------------------------------------------------;
TIMC_VL			.equ		0*100H+00H	; [TCCTL]  timer-C 1 sample increment
					; [TIMC]   timer-C start count value
	;-------------------------------------------------------;
	;	for interrupt control				;
	;-------------------------------------------------------;
INT_EN			.equ	00010001000B	;[SCIEB] Interrupt Request EN/DI
;				   |   +-------- bit3:scsp midi input int.
;				   +------------ bit7:enablee timer b
INT_RD			.equ	0		; [SCIPD] Interrupt Request status read
INT_RST			.equ	00011000000B	; [SCIRE] Interrupt Reset
;				   |+----------- bit6:reset timer a
;				   +------------ bit7:reset timer b
	.if	sw_MODEL_M
SCSP_IPL0		.equ	00000000B	;[SCILV0] scsp interrupt level set
SCSP_IPL1		.equ	10000000B	;[SCILV1]
SCSP_IPL2		.equ	00000000B	;[SCILV2]
;				+--------------- 010:Timer-B,C,MIDIout,1Fs level2
	.else
SCSP_IPL0		.equ	00001000B	;[SCILV0] scsp interrupt level set
SCSP_IPL1		.equ	10000000B	;[SCILV1]
SCSP_IPL2		.equ	00001000B	;[SCILV2]
;				|   +----------- 101:scsp midi input level5
;				+--------------- 010:Timer-B,C,MIDIout,1Fs level2
	.endif

;-----------------------------------------------------------------------;
;	data assign for YM3802 register 				;
;-----------------------------------------------------------------------;
	.if	sw_MODEL_M
R00		.equ		0*2		;MCS R00
R01		.equ		1*2		;MCS R01
R02		.equ		2*2		;MCS R02
R03		.equ		3*2		;MCS R03
Rx4		.equ		4*2		;MCS R04,R14,R24,R34,R44,R54,R64,R74,R84,R94
Rx5		.equ		5*2		;MCS R05,R15,R25,R35,R45,R55,R65,R75,R85,R95
Rx6		.equ		6*2		;MCS R06,R16,R26,R36,    R56,R66,R76,R86,R96
Rx7		.equ		7*2		;MCS     R17,R27,            R67,R77,R87    
;
;
init_R04		equ	00000000B	; R04 ( IRQ vector offset = 0 )
init_R06		equ	00100000B	; R06 ( IRQ enable select )
;				  +------------- bit5:enable FIFO-Rx ready
init_R94		equ	00000000B	; R94 ( all I/O input mode )
init_R55		equ	10000101B	; R55 ( FIFO-Tx control )
;				|    | +-------- bit0:transmitter enable
;				|    +---------- bit2:clear Tx idle flag
;				+--------------- bit7:clear FIFO-Tx
init_R35		equ	11001101B	; R35 ( FIFO-Rx control )
;				||  || +-------- bit0:receiver enable	
;				||  |+---------- bit2:clear off-line åüèo flag
;				||  +----------- bit3:clear break åüèo flag	
;				|+-------------- bit6:clear over-flow åüèo flag
;				+--------------- bit7:clear FIFO-Rx		

init_R44		equ	00001000B	; R44 ( send rate setting )
;				   +++++-------- bit4-0:CLKM/32 (1MHz/32=31250bps)
init_R45		equ	00000000B	; R45 ( send mode setting )
;		bit length 8/parity disable/no parity bit/no porarity/stop bit 1
init_R24		equ	00001000B	; R24 ( receive rate setting )
;				   +++++-------- bit4-0:CLKM/32 (1MHz/32=31250bps)
init_R25		equ	00000000B	; R25 ( receive mode setting )
;		bit length 8/parity disable/no parity bit/no porarity/stop bit 1

	.endif

;=======================================================================;
;	midi data							;
;=======================================================================;
MIDI_EXCL		.equ		$F0	; MIDI Exclusive
MIDI_EOX		.equ		$F7	; MIDI End of Exclusive
MIDI_TCLK		.equ		$F8	; MIDI timing clock
MIDI_ASNS		.equ		$FE	; MIDI Active Sensing
YAMAHA_ID		.equ		$43	;product id #
YAMAHA_DIV		.equ		$79	;
DVID			.equ		$00	;
SATURN_ID		.equ		$01	;

;-----------------------------------------------------------------------;
;	system macro define						;
;-----------------------------------------------------------------------;
	;-------------------------------------------------------;
	;	status register					;
	;-------------------------------------------------------;
sr_push	.macro
		move	sr,-(sp)		;status push
	.endm

sr_pop	.macro
		move	(sp)+,sr		;status pop
	.endm

int_di	.macro
		move.w	#$2700,sr		;interrupt disable
	.endm
	;-------------------------------------------------------;
	;	carry flag					;
	;-------------------------------------------------------;
stc	.macro
		ori	#00000001B,ccr		;set carry flag
	.endm

clc	.macro
		or	d0,d0			;reset carry flag
	.endm

;-----------------------------------------------------------------------;
;	error status	(* sign:model m only)				;
;-----------------------------------------------------------------------;
RET_NORMAL		.equ		$00	;normal
RET_ERR_RESOVAL		.equ		$80	;out of resolution value
RET_ERR_NOTEMPO		.equ		$81	;tempo data not found
RET_ERR_NOEVENT		.equ		$82	;event data not found
RET_ERR_TEMPOVAL	.equ		$83	;out of tempo value
RET_ERR_NOCONTROL	.equ		$84	;no control in sequence data
BANK_NOT_FOUND		.equ		$85	;bank not found
PROGRAM_NOT_FOUND	.equ		$86	;program not found
BANK_NOT_AVAIRABLE	.equ		$87	;bank not avairable
OUT_OF_TOTAL_LEVEL	.equ		$88	;out of TL range (illegal volume bias)
ILLEGAL_MIXER_CHANGE	.equ		$89	;illegal mixer change
FEATURE_NOT_AVAIRABLE	.equ		$8a	;feature not avairable(ex.mono mode)
ILLEGAL_LAYER		.equ		$8b	;illegal layer
VOICE_FULL		.equ		$8c	;voice full (kill oldest note)
LAYER_NOT_FOUND		.equ		$8d	;layer not found
DSP_ERROR		.equ		$8e	;dsp error (see manual)
MIDI_NOT_AVAIRABLE	.equ		$8f	;midi event not avairable
KEYOFF_ALONE		.equ		$90	;key-off Ç∑Ç◊Ç´ key-oníÜslotÇ™ë∂ç›ÇµÇ»Ç¢
ALL_NOTE_OFF_INPUT	.equ		$91	;all note off (developer only)
TOO_MANY_FM_CHANNELS	.equ		$92	;too many fm channels
MALTIPLE_SLOT_ASSIGN	.equ		$93	;multiple slot assign(program error)
TOO_LARGE_CHANNEL	.equ		$94	;illegal midi channel #
;@;VOICE_WARNING_LEVEL1	.equ		$96	;ÉLÅ[ÉIÉtÇ≥ÇÍÇƒÇ¢Çƒ,ÉäÉäÅ[ÉXÉåÉxÉãÇ™4à»â∫ÇÃÉXÉçÉbÉgÇäÑÇËìñÇƒÇΩ.
VOICE_WARNING_LEVEL2	.equ		$97	;*ignore 'rerease end'slot,because too many notes
VOICE_WARNING_LEVEL3	.equ		$98	;*too many notes(over 32) in same management #
KEY_ON_CANCEL		.equ		$99	;key on cancel,because all of slots filled by FM

;-----------------------------------------------------------------------;
;	command # assign for branch table				;
;-----------------------------------------------------------------------;
start_command		.equ	0*8
stop_command		.equ	1*8
pause_command		.equ	2*8
continue_command	.equ	3*8

