;	CPU : MC68000 ( É” = 9.87 MHz )


off		equ	0
on		equ	.not.off

;---------------------------------------------------------------;
;	assemble switch 1					;
;---------------------------------------------------------------;
sw_MODEL_M              .equ    off		;on:for model M
ENGN                    .equ    off		;on:engine contol
SW_TITAN                .equ    off		;on:for ST-V
compatible		.equ	off		;on:host command $0c,$0d
rereaseCheck		.equ	off		;on:use rerease check
;---------------------------------------------------------------;
;	assemble switch 2					;
;---------------------------------------------------------------;

		.if sw_MODEL_M
SCSI_RAM_chk		.equ	off		;SCSI access S-RAM R/W check
		.else
SCSI_RAM_chk		.equ	off		;don't toutch
		.endif

;---------------------------------------------------------------;
;	default value						;
;---------------------------------------------------------------;
default_volume		.equ	$7f		;default midi volume

;---------------------------------------------------------------;
;	hardware memory map					;
;---------------------------------------------------------------;
IO_DRAM			.equ		$000000	;d-ram
DRAM_size		.equ		$100000	;8Mbit(1Mbytes)
IO_SCSP			.equ		$100000	;scsp
		.if	sw_MODEL_M
IO_EXP			.equ		$200000	;model-M expanded I/O
IO_DMA			.equ		$400000	;dma controller
IO_ROM			.equ		$600000	;rom
IO_EMU			.equ		$800000	;emulation
IO_SCSI			.equ		$a00000	;scsi
IO_LED			.equ		$c00000	;led
IO_MIDI1		.equ		$d00000	;midi
IO_MIDI2		.equ		$d80000	;midi
IO_SRAM1		.equ		$e00000	;s-ram
IO_SRAM2		.equ		$f00000	;s-ram
SRAM1_size		.equ		$40000	;1Mbit x 2
SRAM2_size		.equ		$40000	;1Mbit x 2
		.endif

		.if	SW_TITAN
;+-------+-------+-------+-------+-------+-------+-------+-------+
;| bit 7 |     6 |     5 |     4 |     3 |     2 |     1 |     0 |
;+-------+-------+-------+-------+-------+-------+-------+-------+
;|xxxxxxx|xxxxxxx|jamma D|jamma26|jamma C|jamma25|coin 2 |coin 1 |
;+-------+-------+-------+-------+-------+-------+-------+-------+
IO_PORT_C		.equ		$600000	;
		.endif
;---------------------------------------------------------------;
SCSP_slot_unit		.equ	$20		;slot unit size
SCSP_SLOT_SIZE  	.equ	SCSP_slot_unit	;
;---------------------------------------------------------------;
;	d-ram map base def.					;
;---------------------------------------------------------------;
sz_SIFTB		.equ		$040	;system interface table size
sz_SINFO		.equ		$040	;system information table size
sz_SIFWK		.equ		$080	;system interface work size
sz_AMAPC		.equ		$100	;sound area map CRNT work size
sz_TIFWK		.equ		$080	;tool interface work size
sz_MONTR		.equ		$080	;monitor work size
sz_HIFWK		.equ		$100	;host interface work size

bs_SIFTB		.equ		$0400	;system i/f table
bs_SINFO		.equ		$0440	;system information table
bs_SIFWK		.equ		$0480	;system i/f work top
bs_AMAPC		.equ		$0500	;area map current work top addr
bs_TIFWK		.equ		$0600	;tool i/f work top
bs_MONTR		.equ		$0680	;monitor buffer top
host_if_work		.equ		$0700	;host i/f work top
bs_CMDHS		.equ		$0800	;host command history buffer top
bs_PRGTP		.equ		$1000	;68k prg top address
sz_PRG			.equ		$6000	;68k program size
bs_PWKTP		.equ	bs_PRGTP+sz_PRG	;68k work top address
sz_Prg_wk		.equ		$3000	;68K work size
bs_SSP			.equ	bs_PWKTP+sz_Prg_wk	; stack pointer initial
bs_AREAM		.equ	bs_SSP		;area map buffer
sz_AREAM		.equ		$1000	;area map buffer size
;-----------------------------------------------------------------------;
;	driver work ram address or base					;
;-----------------------------------------------------------------------;
kanri_wk		.equ		$0000	; 1000H
slot_work		.equ		$1000	;  800H
common_wk		.equ		$1800	;   6EH
mixer_wk_edt		.equ		$186C	;   12H	Tone Editor Ç…ÇÊÇÈïœçXíºëOÇÃÇlixer data
mixer_wk_SCSP		.equ		$187E	;   12H	é¿ç€ÇÃÇrÇbÇrÇoè„Ç÷ÇÃèëçûçœÇlixer data
Pcm_Strm		.equ		$1890	;   10H PCM stream Playing SCSP slot#
MIDIA_wk		.equ		$18A0	;   10H
;@MIDIB_wk		.equ		$18B0	;   10H
_KEYHISTB		.equ		$18C0	;   40H
_DVA_layer		.equ		$1900	;  100H
_MIDI_RCV_BF		.equ		$1A00	;  400H	;100H 4byte íPà 
_DFL_ELMNT_wk		.equ		$1E00	;  100H
;.........		.equ		$1F00	;  100H
_MIDI_OUT_BF		.equ		$2000	;  400H	95/07/12
_EXCL_RCV_BF		.equ		$2400	;  180H
;.........		.equ		$2580	;  280H
DEC_WORK_OFFSET		.equ		$2800		;SEQ âìÄ work offset value
SY_TOP			.equ		$0000		; area top offset
SQ_TOP			.equ		$0100		;
NC_TOP			.equ		$0400		;
	;-------------------------------------------------------;
	;	decoder work					;
	;-------------------------------------------------------;
SQ_NUM			.equ		8		;sequence management #
SQ_SIZ			.equ		96		;management work size(don't care)
NC_NUM			.equ		32		;slot # for note on cue
NC_SIZ			.equ		12		;cue data size

;SY_NUM		equ	1		; system control block number
;SY_SIZ		equ	64		;                      size
;SY_MAX		equ	SY_SIZ*SY_NUM	;                      area size
;SQ_MAX		equ	SQ_SIZ*SQ_NUM	;                        area size
;NC_MAX		equ	NC_SIZ*NC_NUM	;             area size

midi_receive_buffer	.equ	bs_PWKTP+_MIDI_RCV_BF		;$8a00
exclusive_receive_buf	.equ	bs_PWKTP+_EXCL_RCV_BF		;$9400
decoder_work		.equ	bs_PWKTP+DEC_WORK_OFFSET	;$9800
management_work		.equ	bs_PWKTP+DEC_WORK_OFFSET+SQ_TOP	;$9900
note_on_cue_table	.equ	bs_PWKTP+DEC_WORK_OFFSET+NC_TOP	;$9c00


;---------------------------------------------------------------;
; $0400 -							;
;	system i/f						;
;---------------------------------------------------------------;
Mem_SYINFO_PTR		.equ     bs_SIFTB+$00	;system i/f table top addr
Mem_HOSTIF_PTR		.equ	bs_SIFTB+$04	;host interface work pointer
Mem_MAPCRNT_PTR		.equ	bs_SIFTB+$08	;map crnt work pointer
Mem_TOOLIF_PTR		.equ	bs_SIFTB+$0c	;tool interface work pointer
Mem_DSP_FLG		.equ	bs_SIFTB+$10	;work
Mem_DRV_FLG		.equ	bs_SIFTB+$11	;sound driver load flag
Mem_IFWK_PTR		.equ	bs_SIFTB+$12	;system i/f work pointer
Mem_DRVERR_FLG		.equ	bs_SIFTB+$16	;error flags (w)
	;-----------------------------------------------;
	;	Mem_DRVERR_FLG	($0416)			;
	;-----------------------------------------------;
;ERRa15		.equ	7		;always 0
ERRa14		.equ	6		;
ERRa13		.equ	5		;
ERRa12		.equ	4		;
ERRa11		.equ	3		;
ERRa10		.equ	2		;cannot find key-on slot,ought to key-off(poly mode)
ERRa_9		.equ	1		;MIDI ch 10HÅ`1FH input
ERRa_8		.equ	0		;cannot find key-on slot,ought to key-off(mono mode)
;ERRa_7		.equ	7		;always 0
ERRa_6		.equ	6		;max voice #(32) overflow
ERRa_5		.equ	5		;illegal layer # in tone bank
ERRa_4		.equ	4		;MIDI F0HÅ`FFH input
ERRa_3		.equ	3		;MIDI channel pressure
ERRa_2		.equ	2		;MIDI Polyphonic Key pressure
ERRa_1		.equ	1		;unregestered level#6
ERRa_0		.equ	0		;unregestered level#5
	;-----------------------------------------------;
Mem_HD_chk		.equ	bs_SIFTB+$18	;word
Mem_CMDHS_pt		.equ	bs_SIFTB+$1A	;(word) HOST Commnd bufferring point
Mem_err_bit		.equ	bs_SIFTB+$20	;error flags (l)
	;-----------------------------------------------;
	;	Mem_err_bit	($0420)			;
	;-----------------------------------------------;
;ERRb31		.equ	7		;always 0
ERRb30		.equ	6		;cpu buss error
ERRb29		.equ	5		;cpu exception
ERRb28		.equ	4		;cpu address error
ERRb27		.equ	3		;midi receive buffer overflow
ERRb26		.equ	2		;illegal MIDI exclusive receive
ERRb25		.equ	1		;
ERRb24		.equ	0		;
;ERRb23		.equ	7		;always 0
ERRb22		.equ	6		;illegal effect change #(over 0FH)
ERRb21		.equ	5		;
ERRb20		.equ	4		;sddrvs.tsk ÇÃ mediaä‘Ç≈ÇÃï°êªÉ~ÉX
ERRb19		.equ	3		;r/w size > $20040
ERRb18		.equ	2		;cannot find äYìñ SEQ Song#
ERRb17		.equ	1		;note-on éû not ready [k_BANK_adr]
ERRb16		.equ	0		;note-on éû äYìñÇkayer nothing
;ERRb15		.equ	7		;always 0
ERRb14		.equ	6		;illegal control change # receive
ERRb13		.equ	5		;not enough memory
ERRb12		.equ	4		;dsp access area unit is 2000H
ERRb11		.equ	3		;cannot find dsp-ram-id
ERRb10		.equ	2		;not dsp-prg down load
ERRb_9		.equ	1		;cannot find dsp-prg-id
ERRb_8		.equ	0		;cannot down load SEQ data
;ERRb_7		.equ	7		;always 0
ERRb_6		.equ	6		;cannot find äYìñ seq bank#
ERRb_5		.equ	5		;voice# too large
ERRb_4		.equ	4		;not ready tone-bank
ERRb_3		.equ	3		;not ready scspbin address
ERRb_2		.equ	2		;not find tone bank id or data not ready
ERRb_1		.equ	1		;not find map
ERRb_0		.equ	0		;not find mixer
;---------------------------------------------------------------;
; $0440 -							;
;	system information					;
;---------------------------------------------------------------;
Mem_bs_PRGTP		.equ	bs_SINFO+$00	; 68K Program   top
Mem_sz_PRG		.equ	bs_SINFO+$04	;      //       size
Mem_bs_AREAM		.equ	bs_SINFO+$08	; Area Map area top
Mem_sz_AREAM		.equ	bs_SINFO+$0C	;      //       size
Mem_bs_PWKTP		.equ	bs_SINFO+$10	; 68K Prg work  top
Mem_sz_Prg_wk		.equ	bs_SINFO+$14	;      //       size
;-----------------------------------------------------------------------;
; $0480 -								;
;	system i/f work							;
;-----------------------------------------------------------------------;
OF_IPT_CTRL		.equ		$00		;interrupt control word
OF_IPT_MODE		.equ		$01		;interrupt mode
OF_PCM_PLAYNUM  	.equ		$02		;pcm play number
OF_MONO_FLAG		.equ		$03		;tv mono/stereo flag
monauralFlag		.equ	bs_SIFWK+OF_MONO_FLAG	;abs address
OF_3D_FLAG		.equ		$04		;3d sound control flag
OF_QCOEF_PTR		.equ		$05		;q  sound coef pointer
OF_3DCOEF_PTR   	.equ		$06		;3d sound coef pointer
OF_3DADRS_PTR   	.equ		$07		;3d sound madrs pointer
OF_3DCH1_WORK   	.equ		$08		;3d sound ch1 work
OF_3DCH2_WORK   	.equ		$18		;3d sound ch2 work
OF_3DPRG_WORK   	.equ		$28		;3d sound PROGRAM work
OF_HNDSHK_EN		.equ		$60		;host i/f hand-shake en/di
handShakeFlag		.equ	bs_SIFWK+OF_HNDSHK_EN	;abs address
OF_HNDSHK_flg		.equ		$61		;hand shake flag
handShakeMode		.equ	bs_SIFWK+OF_HNDSHK_flg	;abs address
handShake	.equ	7		;bit7	H:HOST I/F Hand-shake on
midiDataOut	.equ	6		;   6	H:MIDIèàóù MIDI data out
cmdMidiOut	.equ	5		;   5	H:HOST input Command MIDI out
scspMidiInCtrl	.equ	4		;   4	H:SCSP MIDI input Control
OF_EXTMIDI_No		.equ		$62		; EXT MIDI î≠âπä«óùî‘çÜ
