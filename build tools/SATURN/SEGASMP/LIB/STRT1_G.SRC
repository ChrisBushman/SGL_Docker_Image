;	Updated by M.K on 1994-11-11 Ver.1.10
;Note:
;	スタックポインタの初期化、Ｃモジュール実行開始ルーチンの呼び出し、
;	およびセクションアドレステーブルの定義をする。
;=======================================================================
	.SECTION P,CODE,ALIGN=4
	.IMPORT	__INIT
;
STACKPTR .EQU	H'060ffc00
;
	.GLOBAL	START
START:
	MOV.L	STACKPTR_R,R0
	MOV.L	R0,R15
	MOV.L	AP_START_R,R0
	JMP	@R0
	NOP
;
	.ALIGN	4
AP_START_R:
	.DATA.L	__INIT
STACKPTR_R:
	.DATA.L	STACKPTR

	.ALIGN	4
	.GLOBAL	__MD_BGN
	.GLOBAL	__D_BGN
	.GLOBAL	__D_END
	.GLOBAL	__B_BGN
	.GLOBAL	__B_END

__MD_BGN .DATA.L STARTOF_MR
__D_BGN  .DATA.L STARTOF_R
__D_END  .DATA.L ENDOF_R
__B_BGN  .DATA.L STARTOF_B
__B_END  .DATA.L ENDOF_B


	.END
;====== End of file ====================================================
